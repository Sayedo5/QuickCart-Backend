NODE_ENV=development
PORT=4000
APP_NAME=QuickCart
CLIENT_ORIGINS=http://localhost:3000,http://localhost:8081

# Neon: pooled URL for the app, direct URL for Prisma migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Email OTP (leave SMTP_HOST empty to log codes to the console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QuickCart <no-reply@quickcart.pk>"

# Cloudinary (leave empty to disable uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin account
ADMIN_EMAIL=admin@quickcart.pk
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=QuickCart Admin

# Expo push (optional access token for higher rate limits)
EXPO_ACCESS_TOKEN=
